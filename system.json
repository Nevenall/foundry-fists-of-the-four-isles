{
  "id": "fists-of-the-four-isles",
  "title": "Fists of the Four Isles!",
  "description": "A Multicultural Martial Arts Action Game.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": 14,
    "verified": 14
  },
  "esmodules": [
    "fists-of-the-four-isles.mjs"
  ],
  "styles": [
    "styles/fists-of-the-four-isles.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "notes"
        ]
      }
    }
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  }
}