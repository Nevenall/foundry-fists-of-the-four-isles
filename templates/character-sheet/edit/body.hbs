<section class="sheet-body scrollable">
  <fieldset class="input-grid">
    <legend>{{localize "FISTS.FatePoints.Title"}}</legend>
    {{formGroup systemFields.fatePoints.fields.value value=source.system.fatePoints.value label="FISTS.FatePoints.Value" localize=true rootId=rootId}}
    {{formGroup systemFields.fatePoints.fields.refresh value=source.system.fatePoints.refresh label="FISTS.FatePoints.Refresh" localize=true rootId=rootId}}
  </fieldset>

  <fieldset>
    <legend>{{localize "FISTS.Traits.Title"}}</legend>
    <ul class="entries">
      {{#each traits as |trait|}}
      <li class="trait">
        <div class="entry-row">
          {{formInput trait.fields.name name=trait.names.name value=trait.source.name placeholder=(localize "FISTS.Trait.Name") aria=(object label=(localize "FISTS.Trait.Name"))}}
          {{formInput trait.fields.rating name=trait.names.rating value=trait.source.rating aria=(object label=(localize "FISTS.Trait.Rating"))}}
          <label class="flag">{{formInput trait.fields.trouble name=trait.names.trouble value=trait.source.trouble}} {{localize "FISTS.Trait.Trouble"}}</label>
          <label class="flag">{{formInput trait.fields.desire name=trait.names.desire value=trait.source.desire}} {{localize "FISTS.Trait.Desire"}}</label>
          <label class="flag">{{formInput trait.fields.magic name=trait.names.magic value=trait.source.magic}} {{localize "FISTS.Trait.Magic"}}</label>
          {{#if trait.isStyle}}<span class="style-tag">{{localize "FISTS.Trait.Style"}}</span>{{/if}}
          <button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteEntry" data-collection="{{trait.collection}}" data-entry-id="{{trait.id}}" data-tooltip aria-label="{{localize "FISTS.Entry.Delete"}}"></button>
        </div>
        {{formInput trait.fields.description name=trait.names.description value=trait.source.description placeholder=(localize "FISTS.Entry.Description") aria=(object label=(localize "FISTS.Entry.Description"))}}
        {{#each trait.lists as |list|}}
        {{> "systems/fists-of-the-four-isles/templates/character-sheet/entry-list.hbs" list}}
        {{/each}}
      </li>
      {{/each}}
    </ul>
    <div class="form-footer">
      <button type="button" data-action="addEntry" data-collection="system.traits" data-kind="trait"><i class="fa-solid fa-plus" inert></i> {{localize "FISTS.Traits.AddTrait"}}</button>
      <button type="button" data-action="addEntry" data-collection="system.traits" data-kind="style"><i class="fa-solid fa-plus" inert></i> {{localize "FISTS.Traits.AddStyle"}}</button>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "FISTS.Techniques.Independent"}}</legend>
    {{> "systems/fists-of-the-four-isles/templates/character-sheet/entry-list.hbs" techniques}}
  </fieldset>

  <fieldset>
    <legend>{{localize "FISTS.Notes.Title"}}</legend>
    {{formInput systemFields.notes value=source.system.notes enriched=notesHTML toggled=true}}
  </fieldset>
</section>
