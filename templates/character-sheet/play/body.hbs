<section class="sheet-body scrollable">
  {{#if traits.length}}
  <fieldset>
    <legend>{{localize "FISTS.Traits.Title"}}</legend>
    <ul class="entries trait-grid">
      {{#each traits as |trait|}}
      <li class="trait">
        <div class="trait-heading">
          <span class="trait-title"><span class="trait-name">{{trait.source.name}}</span>&nbsp;<span class="trait-rating">{{trait.source.rating}}</span></span>
          {{#if trait.isStyle}}<span class="tag tag-style">{{localize "FISTS.Trait.Style"}}</span>{{/if}}
          {{#if trait.source.trouble}}<span class="tag tag-trouble">{{localize (concat "FISTS.Trouble.Tags." trait.source.trouble)}}</span>{{/if}}
          {{#if trait.source.desire}}<span class="tag tag-desire">{{localize "FISTS.Trait.Desire"}}</span>{{/if}}
          {{#if trait.source.magic}}<span class="tag tag-magic">{{localize "FISTS.Trait.Magic"}}</span>{{/if}}
          <button type="button" class="inline-control icon fa-solid fa-dice" data-action="rollTrait" data-entry-id="{{trait.id}}" data-tooltip aria-label="{{localize "FISTS.Trait.Roll" name=trait.source.name}}"></button>
        </div>
        {{#if trait.source.description}}<p>{{trait.source.description}}</p>{{/if}}
        {{#each trait.lists as |list|}}
        {{> "systems/fists-of-the-four-isles/templates/character-sheet/play/entry-list.hbs" list}}
        {{/each}}
      </li>
      {{/each}}
    </ul>
  </fieldset>
  {{/if}}

  {{#if techniques.entries.length}}
  <fieldset>
    <legend>{{localize "FISTS.Techniques.Independent"}}</legend>
    {{> "systems/fists-of-the-four-isles/templates/character-sheet/play/entry-list.hbs" techniques}}
  </fieldset>
  {{/if}}

  <fieldset>
    <legend>{{localize "FISTS.Notes.Title"}}</legend>
    {{formInput systemFields.notes value=source.system.notes enriched=notesHTML toggled=true}}
  </fieldset>
</section>
