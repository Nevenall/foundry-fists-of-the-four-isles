<div class="fists-of-the-four-isles roll-card">
  <p class="comparison">{{localize comparison}}</p>
  <div class="roll-halves">
    {{#each halves as |half|}}
    <section class="roll-half">
      <h4>{{localize half.label}}</h4>
      <div class="die-result{{#if half.higher}} higher{{/if}}">
        <span class="die-size"><i class="fa-solid fa-dice-{{half.size}}" inert></i> {{half.size}}</span>
        <span class="die-total">{{half.rolled}}</span>
      </div>
      <dl>
        {{#each half.modifiers as |modifier|}}
        <div><dt>{{localize modifier.label}}</dt><dd>{{modifier.value}}</dd></div>
        {{/each}}
        <div class="half-total"><dt>{{localize half.totalLabel}}</dt><dd>{{half.total}}</dd></div>
      </dl>
    </section>
    {{/each}}
  </div>
  <dl class="final-result">
    <div><dt>{{localize "FISTS.Roll.Result"}}</dt><dd>{{result}}</dd></div>
  </dl>
</div>
